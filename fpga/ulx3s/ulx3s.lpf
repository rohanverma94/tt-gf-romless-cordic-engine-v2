# ulx3s.lpf — pins for xcordic_ulx3s.v on a ULX3S v2.x / v3.x (LFE5U-85F, CABGA381).
# Sites taken from the board's reference constraints (emard/ulx3s, ulx3s_v20.lpf).
# Check them against the .lpf for your board revision before the first run.

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE;

# 25 MHz oscillator
LOCATE COMP "clk_25mhz" SITE "G2";
IOBUF  PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;

# LEDs
LOCATE COMP "led[0]" SITE "B2";
LOCATE COMP "led[1]" SITE "C2";
LOCATE COMP "led[2]" SITE "C1";
LOCATE COMP "led[3]" SITE "D2";
LOCATE COMP "led[4]" SITE "D1";
LOCATE COMP "led[5]" SITE "E2";
LOCATE COMP "led[6]" SITE "E1";
LOCATE COMP "led[7]" SITE "H3";
IOBUF  PORT "led[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "led[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# Buttons: btn[0] PWR (active low), btn[1..6] F1 F2 UP DOWN LEFT RIGHT (active high)
LOCATE COMP "btn[0]" SITE "D6";
LOCATE COMP "btn[1]" SITE "R1";
LOCATE COMP "btn[2]" SITE "T1";
LOCATE COMP "btn[3]" SITE "R18";
LOCATE COMP "btn[4]" SITE "V1";
LOCATE COMP "btn[5]" SITE "U1";
LOCATE COMP "btn[6]" SITE "H16";
IOBUF  PORT "btn[0]" PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF  PORT "btn[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "btn[2]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "btn[3]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "btn[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "btn[5]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "btn[6]" PULLMODE=DOWN IO_TYPE=LVCMOS33;

# Header J1, 3.3 V: gp[n] is the "n+" pin, gn[n] the "n-" pin on the silkscreen
# inputs from the Pico (pulled to their idle level so an open wire is harmless)
LOCATE COMP "gp[0]" SITE "B11";   # SCLK   <- Pico GP2
LOCATE COMP "gp[1]" SITE "A10";   # MOSI   <- Pico GP3
LOCATE COMP "gp[2]" SITE "A9";    # unused (was CS_N; J1-9 had a bad contact)
LOCATE COMP "gp[3]" SITE "B9";    # PROTO  <- Pico GP6
LOCATE COMP "gp[4]" SITE "A7";    # CPHA   <- Pico GP7
IOBUF  PORT "gp[0]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "gp[1]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "gp[2]" PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF  PORT "gp[3]" PULLMODE=UP   IO_TYPE=LVCMOS33;
IOBUF  PORT "gp[4]" PULLMODE=DOWN IO_TYPE=LVCMOS33;
LOCATE COMP "gp[5]" SITE "C8";    # CS_N   <- Pico GP5 (J1-15+)
IOBUF  PORT "gp[5]" PULLMODE=UP   IO_TYPE=LVCMOS33;
# outputs to the Pico
LOCATE COMP "gn[0]" SITE "C11";   # MISO        -> Pico GP4
LOCATE COMP "gn[1]" SITE "A11";   # DATA_READY  -> Pico GP8
LOCATE COMP "gn[2]" SITE "B10";   # BUSY        -> Pico GP9
IOBUF  PORT "gn[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF  PORT "gn[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "gn[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gn[3]" SITE "C10";   # BUSY again (J1-11-), a spare for GP9
IOBUF  PORT "gn[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
