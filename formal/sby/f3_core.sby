b_op18_g0 b op18 g0
b_op19_g0 b op19 g0
b0_op0_g0 b funcs0 op0 g0
b0_op1_g0 b funcs0 op1 g0
b0_op2_g0 b funcs0 op2 g0
b0_op3_g0 b funcs0 op3 g0
b0_op4_g0 b funcs0 op4 g0
b0_op5_g0 b funcs0 op5 g0
b0_op6_g0 b funcs0 op6 g0
b0_op7_g0 b funcs0 op7 g0
cov_op10_g0 cov op10 k2 g0
cov_op12_g0 cov op12 k2 g0
cov_op17_g0 cov op17 k0 g0
cov_op18_g0 cov op18 k2 g0
cov_op19_g0 cov op19 k3 g0
a_funcs1_g4 a g4
a_funcs0_g4 a funcs0 g4
b_op0_g4 b op0 g4
b_op1_g4 b op1 g4
b_op2_g4 b op2 g4
b_op3_g4 b op3 g4
