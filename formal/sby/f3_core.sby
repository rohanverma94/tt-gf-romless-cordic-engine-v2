[options]
a: mode prove
a: depth 6
b: mode bmc
b: depth 35
cov: mode cover
cov: depth 35

[engines]
smtbmc yices

[script]
g0: read -define XC_GUARD=0
g4: read -define XC_GUARD=4
a: read -formal -D XC_FV_CORE -D XC_CORE_A xcordic_core.v xc_add.v xcordic_engine_abstract.v xc_exact_abstract.v
k0: read -define XC_CORE_B_COVER_K=0
k2: read -define XC_CORE_B_COVER_K=2
k3: read -define XC_CORE_B_COVER_K=3
op0: read -define XC_CORE_B_OP=0
op1: read -define XC_CORE_B_OP=1
op2: read -define XC_CORE_B_OP=2
op3: read -define XC_CORE_B_OP=3
op4: read -define XC_CORE_B_OP=4
op5: read -define XC_CORE_B_OP=5
op6: read -define XC_CORE_B_OP=6
op7: read -define XC_CORE_B_OP=7
op8: read -define XC_CORE_B_OP=8
op9: read -define XC_CORE_B_OP=9
op10: read -define XC_CORE_B_OP=10
op11: read -define XC_CORE_B_OP=11
op12: read -define XC_CORE_B_OP=12
op13: read -define XC_CORE_B_OP=13
op14: read -define XC_CORE_B_OP=14
op15: read -define XC_CORE_B_OP=15
op16: read -define XC_CORE_B_OP=16
op17: read -define XC_CORE_B_OP=17
op18: read -define XC_CORE_B_OP=18
op19: read -define XC_CORE_B_OP=19
b: read -define XC_CORE_B_COVER_K=0
b: read -formal -D XC_FV_CORE -D XC_CORE_B -D XC_CORE_B_MAXCYC=34 -D XC_ENGINE_MAX_LAT=1 -D XC_EXACT_MAX_LAT=2 xcordic_core.v xc_add.v xcordic_engine_abstract.v xc_exact_abstract.v
cov: read -formal -D XC_FV_CORE -D XC_CORE_B -D XC_CORE_B_MAXCYC=34 -D XC_ENGINE_MAX_LAT=1 -D XC_EXACT_MAX_LAT=2 xcordic_core.v xc_add.v xcordic_engine_abstract.v xc_exact_abstract.v
funcs0: chparam -set FUNCS 0 xcordic_core
g4: chparam -set GUARD 4 xcordic_core
prep -top xcordic_core

