# generated by gen_o1.sh new: SPI byte transport against a timed master, any number of frames (PDR)
# cov_m*: two complete frames are reachable (the timing assumptions are not vacuous)
[tasks]
m0_h1_l5_s5
m0_h2_l5_s5
m0_h5_l1_s5
m0_h5_l2_s5
m0_h1_l3_s5
m0_h2_l1_s5
m0_h1_l2_s5
m0_h2_l2_s5
m0_h5_l5_s1
m0_h5_l5_s2
m0_h5_l5_s3
m0_h2_l2_s5_fb3
m0_h5_l1_s5_t1
m1_h1_l5_s5
m1_h2_l5_s5
m1_h5_l1_s5
m1_h5_l2_s5
m1_h1_l3_s5
m1_h2_l1_s5
m1_h1_l2_s5
m1_h2_l2_s5
m1_h5_l5_s1
m1_h2_l2_s5_fb3
m1_h5_l1_s5_t1
cov_m0 cov
cov_m1 cov

[options]
~cov: mode prove
cov: mode cover
cov: depth 148

[engines]
~cov: abc pdr
cov: smtbmc yices

[script]
m0_h1_l5_s5: read -define CPHA=0 H=1 L=5 S=5 T=3 G=5 FB=1 NFRAMES=2
m0_h2_l5_s5: read -define CPHA=0 H=2 L=5 S=5 T=3 G=5 FB=1 NFRAMES=2
m0_h5_l1_s5: read -define CPHA=0 H=5 L=1 S=5 T=3 G=5 FB=1 NFRAMES=2
m0_h5_l2_s5: read -define CPHA=0 H=5 L=2 S=5 T=3 G=5 FB=1 NFRAMES=2
m0_h1_l3_s5: read -define CPHA=0 H=1 L=3 S=5 T=3 G=5 FB=1 NFRAMES=2
m0_h2_l1_s5: read -define CPHA=0 H=2 L=1 S=5 T=3 G=5 FB=1 NFRAMES=2
m0_h1_l2_s5: read -define CPHA=0 H=1 L=2 S=5 T=3 G=5 FB=1 NFRAMES=2
m0_h2_l2_s5: read -define CPHA=0 H=2 L=2 S=5 T=3 G=5 FB=1 NFRAMES=2
m0_h5_l5_s1: read -define CPHA=0 H=5 L=5 S=1 T=3 G=5 FB=1 NFRAMES=2
m0_h5_l5_s2: read -define CPHA=0 H=5 L=5 S=2 T=3 G=5 FB=1 NFRAMES=2
m0_h5_l5_s3: read -define CPHA=0 H=5 L=5 S=3 T=3 G=5 FB=1 NFRAMES=2
m0_h2_l2_s5_fb3: read -define CPHA=0 H=2 L=2 S=5 T=3 G=5 FB=3 NFRAMES=2
m0_h5_l1_s5_t1: read -define CPHA=0 H=5 L=1 S=5 T=1 G=5 FB=1 NFRAMES=2
m1_h1_l5_s5: read -define CPHA=1 H=1 L=5 S=5 T=3 G=5 FB=1 NFRAMES=2
m1_h2_l5_s5: read -define CPHA=1 H=2 L=5 S=5 T=3 G=5 FB=1 NFRAMES=2
m1_h5_l1_s5: read -define CPHA=1 H=5 L=1 S=5 T=3 G=5 FB=1 NFRAMES=2
m1_h5_l2_s5: read -define CPHA=1 H=5 L=2 S=5 T=3 G=5 FB=1 NFRAMES=2
m1_h1_l3_s5: read -define CPHA=1 H=1 L=3 S=5 T=3 G=5 FB=1 NFRAMES=2
m1_h2_l1_s5: read -define CPHA=1 H=2 L=1 S=5 T=3 G=5 FB=1 NFRAMES=2
m1_h1_l2_s5: read -define CPHA=1 H=1 L=2 S=5 T=3 G=5 FB=1 NFRAMES=2
m1_h2_l2_s5: read -define CPHA=1 H=2 L=2 S=5 T=3 G=5 FB=1 NFRAMES=2
m1_h5_l5_s1: read -define CPHA=1 H=5 L=5 S=1 T=3 G=5 FB=1 NFRAMES=2
m1_h2_l2_s5_fb3: read -define CPHA=1 H=2 L=2 S=5 T=3 G=5 FB=3 NFRAMES=2
m1_h5_l1_s5_t1: read -define CPHA=1 H=5 L=1 S=5 T=1 G=5 FB=1 NFRAMES=2
cov_m0: read -define CPHA=0 H=2 L=2 S=5 T=3 G=5 FB=1 NFRAMES=2
cov_m1: read -define CPHA=1 H=2 L=2 S=5 T=3 G=5 FB=1 NFRAMES=2
read -formal spi_master_model.v
read -formal xc_spi_slave_n1.v
read -formal -sv  fv_spi_top.sv
prep -top fv_spi_top
setundef -zero

