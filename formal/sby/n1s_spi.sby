# generated by gen_n1s.sh: N1S, SCLK-domain slave, multiclock tick model (PDR)
[tasks]
m0_h3_l3_s12_t1_g24
m0_h3_l3_s8_t1_g24
m0_h3_l3_s12_t1_g16
m0_h3_l3_s12_t1_g12
m0_h3_l1_s12_t1_g24
m0_h2_l2_s12_t1_g24
m0_h1_l1_s12_t1_g24
m0_h3_l3_s12_t1_g24_fb2
m0_h1_l2_s12_t1_g24_fb2
m1_h3_l3_s8_t1_g24
m1_h3_l3_s4_t1_g24
m1_h3_l3_s8_t1_g16
m1_h3_l3_s8_t1_g12
m1_h3_l1_s8_t1_g24
m1_h2_l2_s8_t1_g24
m1_h1_l1_s8_t1_g24
m1_h3_l3_s8_t1_g24_fb2
m1_h2_l1_s8_t1_g24_fb2
cov_m0 cov
cov_m1 cov

[options]
multiclock on
~cov: mode prove
cov: mode cover
cov: depth 260

[engines]
~cov: abc scorr; dc2; pdr
cov: smtbmc yices

[script]
m0_h3_l3_s12_t1_g24: read -define CPHA=0 H=3 L=3 S=12 T=1 G=24 FB=1
m0_h3_l3_s8_t1_g24: read -define CPHA=0 H=3 L=3 S=8 T=1 G=24 FB=1
m0_h3_l3_s12_t1_g16: read -define CPHA=0 H=3 L=3 S=12 T=1 G=16 FB=1
m0_h3_l3_s12_t1_g12: read -define CPHA=0 H=3 L=3 S=12 T=1 G=12 FB=1
m0_h3_l1_s12_t1_g24: read -define CPHA=0 H=3 L=1 S=12 T=1 G=24 FB=1
m0_h2_l2_s12_t1_g24: read -define CPHA=0 H=2 L=2 S=12 T=1 G=24 FB=1
m0_h1_l1_s12_t1_g24: read -define CPHA=0 H=1 L=1 S=12 T=1 G=24 FB=1
m0_h3_l3_s12_t1_g24_fb2: read -define CPHA=0 H=3 L=3 S=12 T=1 G=24 FB=2
m0_h1_l2_s12_t1_g24_fb2: read -define CPHA=0 H=1 L=2 S=12 T=1 G=24 FB=2
m1_h3_l3_s8_t1_g24: read -define CPHA=1 H=3 L=3 S=8 T=1 G=24 FB=1
m1_h3_l3_s4_t1_g24: read -define CPHA=1 H=3 L=3 S=4 T=1 G=24 FB=1
m1_h3_l3_s8_t1_g16: read -define CPHA=1 H=3 L=3 S=8 T=1 G=16 FB=1
m1_h3_l3_s8_t1_g12: read -define CPHA=1 H=3 L=3 S=8 T=1 G=12 FB=1
m1_h3_l1_s8_t1_g24: read -define CPHA=1 H=3 L=1 S=8 T=1 G=24 FB=1
m1_h2_l2_s8_t1_g24: read -define CPHA=1 H=2 L=2 S=8 T=1 G=24 FB=1
m1_h1_l1_s8_t1_g24: read -define CPHA=1 H=1 L=1 S=8 T=1 G=24 FB=1
m1_h3_l3_s8_t1_g24_fb2: read -define CPHA=1 H=3 L=3 S=8 T=1 G=24 FB=2
m1_h2_l1_s8_t1_g24_fb2: read -define CPHA=1 H=2 L=1 S=8 T=1 G=24 FB=2
cov_m0: read -define CPHA=0 H=3 L=3 S=12 T=1 G=24 FB=1
cov_m1: read -define CPHA=1 H=3 L=3 S=8 T=1 G=24 FB=1
read -define XC_FV_META MASTER_GCLK
read -formal -sv spi_master_model.v xc_meta.v
read -formal -sv xc_spi_slave_sclk_n1s.v
read -formal -sv fv_n1s_top.sv
prep -top fv_n1s_top

[files]
../tb/spi_master_model.v
../tb/fv_n1s_top.sv
../../src/xc_meta.v
../build/gen/xc_spi_slave_sclk_n1s.v
