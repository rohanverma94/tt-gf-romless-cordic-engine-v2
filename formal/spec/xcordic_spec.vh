// xcordic_spec.vh — executable specification of Xcordic, for formal proofs.
//
// Included inside a module (functions only, no state). Every proof compares
// RTL against these functions. Written from docs/XCORDIC_SPEC.md, not from
// the RTL: different coding (integer arithmetic, tables, explicit sigma),
// same meaning.
//
// Parameterized by `XC_GUARD (default 0, the ttsky25a datapath): engine values
// are SP_W = 16 + G bits wide with SP_F = 12 + G fraction bits; operands
// enter as S3.12 times 2^G; final results are rounded back to S3.12.
//
// Layers:
//   sp_angle / sp_shift / sp_step   one CORDIC micro-rotation (the recurrence)
//   sp_quad / sp_unquad             silicon quadrant scheme for rotations
//   sp_norm / sp_shl / sp_scale     normalization and exponent handling
//   sp_alg                          per-instruction algorithm: which engine
//                                   pass to launch next, or the final rd
//
// Encodings shared with the RTL interface:
//   mode 0 circular, 1 linear, 2 hyperbolic
//   dir  0 rotate (sigma = sign z), 1 vector (sigma = -sign y),
//        2 divide (sigma = -sign(x*y))

`ifndef XC_GUARD
`define XC_GUARD 0
`endif

localparam integer SP_G    = `XC_GUARD;
localparam integer SP_W    = 16 + SP_G;                  // engine value width
localparam integer SP_F    = 12 + SP_G;                  // fraction bits
localparam integer SP_ONE  = 1 << SP_F;
localparam integer SP_NPE  = 13 + (SP_G + 1) / 2;        // circular iterations
localparam integer SP_NLIN = (SP_G == 0) ? SP_NPE : SP_F + 1;   // linear iterations
localparam integer SP_REP13 = (SP_NPE >= 14) ? 1 : 0;    // hyperbolic repeats shift 13 too
localparam integer SP_AW   = 38 + 3 * SP_W;              // action width (section 4)

// Constants, generated by toolchain/gen_consts.cpp: round(c * 2^F), except
// LN2_Q = round(ln 2 * 2^(F+4)). K and Kh are the gains of the iteration
// sequences below (circular SP_NPE, hyperbolic sp_niter(2)).
localparam integer SP_HALF_PI = (SP_G == 0) ? 6434 : (SP_G == 1) ? 12868 : (SP_G == 2) ? 25736 : (SP_G == 3) ? 51472 : 102944;
localparam integer SP_PI = (SP_G == 0) ? 12868 : (SP_G == 1) ? 25736 : (SP_G == 2) ? 51472 : (SP_G == 3) ? 102944 : 205887;
localparam integer SP_THREE_HALF_PI = (SP_G == 0) ? 19302 : (SP_G == 1) ? 38604 : (SP_G == 2) ? 77208 : (SP_G == 3) ? 154416 : 308831;
localparam integer SP_TWO_PI = (SP_G == 0) ? 25736 : (SP_G == 1) ? 51472 : (SP_G == 2) ? 102944 : (SP_G == 3) ? 205887 : 411775;
localparam integer SP_INV_K = (SP_G == 0) ? 2487 : (SP_G == 1) ? 4975 : (SP_G == 2) ? 9949 : (SP_G == 3) ? 19898 : 39797;
localparam integer SP_INV_2KH = (SP_G == 0) ? 2473 : (SP_G == 1) ? 4946 : (SP_G == 2) ? 9892 : (SP_G == 3) ? 19784 : 39567;
localparam integer SP_INV_KH = (SP_G == 0) ? 4946 : (SP_G == 1) ? 9892 : (SP_G == 2) ? 19784 : (SP_G == 3) ? 39567 : 79135;
localparam integer SP_LN2_Q = (SP_G == 0) ? 45426 : (SP_G == 1) ? 90852 : (SP_G == 2) ? 181704 : (SP_G == 3) ? 363409 : 726817;

// micro-angle of shift s >= 2, S3.F (generated by toolchain/gen_consts.cpp from
// the shift-add Taylor series; G = 0 is the ttsky25a table)
function integer sp_angle_tab(input hyp, input integer s);
    begin
        sp_angle_tab = 0;
        case (SP_G)
        0: case ({hyp, s[4:0]})
            {1'b0, 5'd2}: sp_angle_tab = 1003;
            {1'b0, 5'd3}: sp_angle_tab = 510;
            {1'b1, 5'd2}: sp_angle_tab = 1045;
            {1'b1, 5'd3}: sp_angle_tab = 514;
            default: sp_angle_tab = 4096 >> s;
        endcase
        1: case ({hyp, s[4:0]})
            {1'b0, 5'd2}: sp_angle_tab = 2007;
            {1'b0, 5'd3}: sp_angle_tab = 1019;
            {1'b0, 5'd4}: sp_angle_tab = 511;
            {1'b0, 5'd14}: sp_angle_tab = 1;
            {1'b1, 5'd2}: sp_angle_tab = 2092;
            {1'b1, 5'd3}: sp_angle_tab = 1029;
            {1'b1, 5'd4}: sp_angle_tab = 513;
            {1'b1, 5'd14}: sp_angle_tab = 1;
            default: sp_angle_tab = 8192 >> s;
        endcase
        2: case ({hyp, s[4:0]})
            {1'b0, 5'd2}: sp_angle_tab = 4014;
            {1'b0, 5'd3}: sp_angle_tab = 2037;
            {1'b0, 5'd4}: sp_angle_tab = 1023;
            {1'b1, 5'd2}: sp_angle_tab = 4184;
            {1'b1, 5'd3}: sp_angle_tab = 2059;
            {1'b1, 5'd4}: sp_angle_tab = 1025;
            default: sp_angle_tab = 16384 >> s;
        endcase
        3: case ({hyp, s[4:0]})
            {1'b0, 5'd2}: sp_angle_tab = 8028;
            {1'b0, 5'd3}: sp_angle_tab = 4075;
            {1'b0, 5'd4}: sp_angle_tab = 2045;
            {1'b1, 5'd2}: sp_angle_tab = 8369;
            {1'b1, 5'd3}: sp_angle_tab = 4118;
            {1'b1, 5'd4}: sp_angle_tab = 2051;
            default: sp_angle_tab = 32768 >> s;
        endcase
        default: case ({hyp, s[4:0]})
            {1'b0, 5'd2}: sp_angle_tab = 16056;
            {1'b0, 5'd3}: sp_angle_tab = 8150;
            {1'b0, 5'd4}: sp_angle_tab = 4091;
            {1'b0, 5'd5}: sp_angle_tab = 2047;
            {1'b1, 5'd2}: sp_angle_tab = 16738;
            {1'b1, 5'd3}: sp_angle_tab = 8235;
            {1'b1, 5'd4}: sp_angle_tab = 4101;
            {1'b1, 5'd5}: sp_angle_tab = 2049;
            default: sp_angle_tab = 65536 >> s;
        endcase
        endcase
    end
endfunction

// =====================================================================
// 1. The CORDIC recurrence
// =====================================================================

// number of micro-rotations per pass
function [4:0] sp_niter(input [1:0] mode);
    integer n;
    begin
        if (mode == 2'd2)      n = SP_NPE + 1 + SP_REP13;   // repeated shifts 4 (and 13)
        else if (mode == 2'd1) n = SP_NLIN;
        else                   n = SP_NPE;
        sp_niter = n[4:0];
    end
endfunction

// shift of iteration k: k itself, except hyperbolic 1,2,3,4,4,5,...
// (and 13,13 when SP_REP13)
function [4:0] sp_shift(input [1:0] mode, input [4:0] k);
    if (mode != 2'd2)                   sp_shift = k;
    else if (k <= 5'd3)                 sp_shift = k + 5'd1;
    else if (SP_REP13 && k >= 5'd14)    sp_shift = k - 5'd1;   // k = 14 repeats shift 13
    else                                sp_shift = k;          // k = 4 repeats shift 4
endfunction

// micro-rotation angle of iteration k, S3.F.
// ROM-less generator values: first one (circular: two) from registers,
// then the table above.
function [SP_W-1:0] sp_angle(input [1:0] mode, input [4:0] k,
                             input [SP_W-1:0] atan0, input [SP_W-1:0] atan1, input [SP_W-1:0] atanh1);
    reg [4:0] s;
    integer a;
    begin
        s = sp_shift(mode, k);
        a = 0;
        if (mode == 2'd1)                    // linear: 2^-s
            a = SP_ONE >> s;
        else if (mode == 2'd2)               // hyperbolic: atanh(2^-s)
            a = (s == 5'd1) ? atanh1 : sp_angle_tab(1'b1, s);
        else if (s == 5'd0)                  // circular: atan(2^-s)
            a = atan0;
        else
            a = (s == 5'd1) ? atan1 : sp_angle_tab(1'b0, s);
        sp_angle = a[SP_W-1:0];
    end
endfunction

// one micro-rotation with shift s and angle alpha, all values wrap at SP_W bits:
//   x' = x - mu*sigma*(y >> s)     mu = +1 circular, 0 linear, -1 hyperbolic
//   y' = y +    sigma*(x >> s)
//   z' = z -    sigma*alpha
// dir = 3: linear rotation of a product (mac, mul); sigma as rotation.
// With GUARD > 0:
//   - x >> s is rounded (half up), not truncated: (x + 2^(s-1)) >> s
//   - once z is exactly 0 the product is complete: x, y, z are held
// (the truncation of x >> s otherwise accumulates over long one-signed runs
// of sigma, e.g. z = 1.0: up to 4 LSB on mul).
function [3*SP_W-1:0] sp_microrot(input [1:0] mode, input [1:0] dir,
                                  input [SP_W-1:0] x, input [SP_W-1:0] y, input [SP_W-1:0] z,
                                  input [4:0] s, input [SP_W-1:0] alpha);
    reg signed [63:0] xi, yi, zi, xs, ys, a, sx, sy, sa, nx, ny, nz;
    reg sigma_pos;
    begin
        xi = $signed(x);  yi = $signed(y);  zi = $signed(z);
        a  = $signed(alpha);                // the engine's angle input is signed
        if (dir == 2'd1)      sigma_pos = (yi < 0);
        else if (dir == 2'd2) sigma_pos = ((yi < 0) != (xi < 0));
        else                  sigma_pos = (zi >= 0);
        xs = xi >>> s;
        ys = yi >>> s;
        if (SP_G > 0 && mode == 2'd1 && dir == 2'd3 && s != 0)
            xs = (xi + (64'sd1 <<< (s - 1))) >>> s;      // rounded
        sx = sigma_pos ? xs : -xs;          // sigma * (x >> s)
        sy = sigma_pos ? ys : -ys;          // sigma * (y >> s)
        sa = sigma_pos ? a  : -a;           // sigma * alpha
        if (mode == 2'd0)      nx = xi - sy;
        else if (mode == 2'd2) nx = xi + sy;
        else                   nx = xi;
        ny = yi + sx;
        nz = zi - sa;
        if (SP_G > 0 && mode == 2'd1 && dir == 2'd3 && zi == 0) begin   // product complete
            nx = xi; ny = yi; nz = zi;
        end
        sp_microrot = {nx[SP_W-1:0], ny[SP_W-1:0], nz[SP_W-1:0]};
    end
endfunction

// iteration k of the recurrence: shift and angle from the tables above
function [3*SP_W-1:0] sp_step(input [1:0] mode, input [1:0] dir,
                              input [SP_W-1:0] x, input [SP_W-1:0] y, input [SP_W-1:0] z, input [4:0] k,
                              input [SP_W-1:0] atan0, input [SP_W-1:0] atan1, input [SP_W-1:0] atanh1);
    sp_step = sp_microrot(mode, dir, x, y, z, sp_shift(mode, k),
                          sp_angle(mode, k, atan0, atan1, atanh1));
endfunction

// =====================================================================
// 2. Arithmetic helpers (exact integer arithmetic, explicit saturation)
// =====================================================================

// saturate to S3.12
function [15:0] sp_sat(input signed [63:0] v);
    if (v > 64'sd32767)       sp_sat = 16'h7fff;
    else if (v < -64'sd32768) sp_sat = 16'h8000;
    else                      sp_sat = v[15:0];
endfunction

// saturate to an SP_W-bit engine value
function [SP_W-1:0] sp_satw(input signed [63:0] v);
    reg signed [63:0] hi;
    begin
        hi = (64'sd1 <<< (SP_W - 1)) - 1;
        if (v > hi)            sp_satw = hi[SP_W-1:0];
        else if (v < -hi - 1)  sp_satw = ~hi[SP_W-1:0];
        else                   sp_satw = v[SP_W-1:0];
    end
endfunction

function [31:0] sp_sext(input [15:0] v);
    sp_sext = {{16{v[15]}}, v};
endfunction

// S3.12 operand -> engine scale S3.F
function signed [63:0] sp_up(input [15:0] v);
    sp_up = $signed(v) * (64'sd1 <<< SP_G);
endfunction

function signed [63:0] sp_abs(input signed [63:0] v);
    sp_abs = (v < 0) ? -v : v;
endfunction

function signed [63:0] sp_max(input signed [63:0] a, input signed [63:0] b);
    sp_max = (a > b) ? a : b;
endfunction

// floor(log2 m), 1 <= m < 2^24
function integer sp_log2(input signed [63:0] m);
    integer i;
    begin
        sp_log2 = 0;
        for (i = 0; i < 24; i = i + 1)
            if (m >= (64'sd1 <<< i)) sp_log2 = i;
    end
endfunction

// shift that brings magnitude m into [2^F, 2^(F+1)), i.e. value [1, 2); 0 for m = 0
function integer sp_norm(input signed [63:0] m);
    sp_norm = (m == 0) ? 0 : SP_F - sp_log2(m);
endfunction

// v * 2^s (s may be negative: floor division)
function signed [63:0] sp_shl(input signed [63:0] v, input integer s);
    sp_shl = (s >= 0) ? (v <<< s) : (v >>> (-s));
endfunction

// v * 2^k, round to nearest (ties up) for k < 0
function signed [63:0] sp_round(input signed [63:0] v, input integer k);
    if (k >= 0) sp_round = v <<< k;
    else        sp_round = (v + (64'sd1 <<< (-k - 1))) >>> (-k);
endfunction

// final result: S3.F value v times 2^k, rounded to S3.12, saturated
function [15:0] sp_scale(input signed [63:0] v, input integer k);
    sp_scale = sp_sat(sp_round(v, k - SP_G));
endfunction

// final result of an S3.F value (k = 0)
function [15:0] sp_rnd(input signed [63:0] v);
    sp_rnd = sp_scale(v, 0);
endfunction

// SAT flag: whether sp_sat / sp_scale / sp_rnd clipped
function sp_sat_s(input signed [63:0] v);
    sp_sat_s = (v > 64'sd32767) || (v < -64'sd32768);
endfunction
function sp_scale_s(input signed [63:0] v, input integer k);
    sp_scale_s = sp_sat_s(sp_round(v, k - SP_G));
endfunction
function sp_rnd_s(input signed [63:0] v);
    sp_rnd_s = sp_scale_s(v, 0);
endfunction

// intermediate value: S3.F value v times 2^k, rounded, saturated to SP_W bits
function [SP_W-1:0] sp_scale_m(input signed [63:0] v, input integer k);
    sp_scale_m = sp_satw(sp_round(v, k));
endfunction

// k * ln 2 in S3.F
function signed [63:0] sp_kln2(input integer k);
    reg signed [63:0] p;
    begin
        p = k;
        sp_kln2 = (p * SP_LN2_Q + 8) >>> 4;
    end
endfunction

// exp/tanh range reduction: k = round(t / ln 2), t in S5.12,
// with 1/ln 2 ~ 1.4375 = 1 + 1/2 - 1/16
function integer sp_expk(input signed [63:0] t);
    sp_expk = (t + (t >>> 1) - (t >>> 4) + 2048) >>> 12;
endfunction

// =====================================================================
// 3. Rotation pre/post processing (silicon quadrant scheme)
// =====================================================================

// {q, reduced angle}: wrap once by 2*pi, then subtract q*pi/2 (all S3.F)
function [SP_W+1:0] sp_quad(input [15:0] th16);
    reg signed [63:0] th;
    reg [1:0] q;
    begin
        th = sp_up(th16);
        if (th < 0)                th = th + SP_TWO_PI;
        else if (th >= SP_TWO_PI)  th = th - SP_TWO_PI;
        if (th < SP_HALF_PI)            q = 2'd0;   // includes still-negative angles
        else if (th < SP_PI)            q = 2'd1;
        else if (th < SP_THREE_HALF_PI) q = 2'd2;
        else                            q = 2'd3;
        case (q)
            2'd0:    th = th;
            2'd1:    th = th - SP_HALF_PI;
            2'd2:    th = th - SP_PI;
            default: th = th - SP_THREE_HALF_PI;
        endcase
        sp_quad = {q, th[SP_W-1:0]};
    end
endfunction

// engine (x, y) after rotating by the reduced angle -> {sin-slot, cos-slot}
function [2*SP_W-1:0] sp_unquad(input [1:0] q, input [SP_W-1:0] x, input [SP_W-1:0] y);
    reg [SP_W-1:0] c, s;
    begin
        case (q)
            2'd0:    begin c = x;      s = y;      end
            2'd1:    begin c = 0 - y;  s = x;      end
            2'd2:    begin c = 0 - x;  s = 0 - y;  end
            default: begin c = y;      s = 0 - x;  end
        endcase
        sp_unquad = {s, c};
    end
endfunction

// =====================================================================
// 4. Per-instruction algorithm
// =====================================================================
// Action after k engine passes, SP_AW = 38 + 3*SP_W bits:
//   {kind[1:0], mode[1:0], dir[1:0], x[SP_W], y[SP_W], z[SP_W], rd[31:0]}
//   kind 0: launch an engine pass (mode, dir, x, y, z)
//   kind 1: finish, write rd
//   kind 2: no action defined (algorithm already finished)
//   kind 3: a launch operand does not fit in SP_W bits (spec arithmetic is
//           exact, so any RTL truncation shows up as a mismatch)

localparam [1:0] SP_LAUNCH = 2'd0, SP_FINISH = 2'd1, SP_NONE = 2'd2, SP_OVF = 2'd3;

function sp_fits(input signed [63:0] v);
    sp_fits = (v < (64'sd1 <<< (SP_W - 1))) && (v >= -(64'sd1 <<< (SP_W - 1)));
endfunction

function [SP_AW-1:0] sp_launch(input [1:0] mode, input [1:0] dir,
                               input signed [63:0] x, input signed [63:0] y, input signed [63:0] z);
    if (!sp_fits(x) || !sp_fits(y) || !sp_fits(z))
        sp_launch = {SP_OVF, {(SP_AW-2){1'b0}}};
    else
        sp_launch = {SP_LAUNCH, mode, dir, x[SP_W-1:0], y[SP_W-1:0], z[SP_W-1:0], 32'd0};
endfunction

function [SP_AW-1:0] sp_finish(input [31:0] rd);
    sp_finish = {SP_FINISH, {(SP_AW-34){1'b0}}, rd};
endfunction

// finish with flags = {INV, SAT}, in action bits 33:32
function [SP_AW-1:0] sp_finish_f(input [31:0] rd, input [1:0] fl);
    sp_finish_f = {SP_FINISH, {(SP_AW-36){1'b0}}, fl, rd};
endfunction

// circular rotation of (x, y) by angle th16
function [SP_AW-1:0] sp_launch_rot(input signed [63:0] x, input signed [63:0] y, input [15:0] th16);
    reg [SP_W+1:0] qa;
    begin
        qa = sp_quad(th16);
        sp_launch_rot = sp_launch(2'd0, 2'd0, x, y, $signed(qa[SP_W-1:0]));
    end
endfunction

// circular vectoring of (x, y): reflect into the right half-plane first
// (SP_W-bit negation, as specified), starting z at +-pi
function [SP_AW-1:0] sp_launch_vec(input signed [63:0] x, input signed [63:0] y);
    reg [SP_W-1:0] nx, ny;
    reg signed [63:0] z0;
    begin
        if (!sp_fits(x) || !sp_fits(y))
            sp_launch_vec = {SP_OVF, {(SP_AW-2){1'b0}}};
        else begin
            if (x < 0) begin
                nx = 0 - x[SP_W-1:0];
                ny = 0 - y[SP_W-1:0];
                z0 = (y < 0) ? -SP_PI : SP_PI;
            end else begin
                nx = x[SP_W-1:0];
                ny = y[SP_W-1:0];
                z0 = 0;
            end
            sp_launch_vec = sp_launch(2'd0, 2'd1, $signed(nx), $signed(ny), z0);
        end
    end
endfunction

// full-range a / b (S3.F): special cases, else normalize both and one
// linear-divide pass; ez is that pass's z
function [SP_AW-1:0] sp_fdiv(input signed [63:0] a, input signed [63:0] b,
                             input phase, input [SP_W-1:0] ez);
    integer sa, sb;
    begin
        sa = sp_norm(sp_abs(a));
        sb = sp_norm(sp_abs(b));
        if (a == 0)       sp_fdiv = sp_finish(32'd0);
        else if (b == 0)  sp_fdiv = sp_finish_f(sp_sext((a < 0) ? 16'h8000 : 16'h7fff), 2'b01);
        else if (!phase)  sp_fdiv = sp_launch(2'd1, 2'd2, sp_shl(b, sb), sp_shl(a, sa), 0);
        else              sp_fdiv = sp_finish_f(sp_sext(sp_scale($signed(ez), sb - sa)),
                                                {1'b0, sp_scale_s($signed(ez), sb - sa)});
    end
endfunction

// op = funct7[1:0] * 8 + funct3; cfg = {kh, atanh1, kc, atan1, atan0} (SP_W each);
// k = engine passes completed; e1..e3 = {x, y, z} returned by passes 1..3
function [SP_AW-1:0] sp_alg(input [4:0] op, input [31:0] rs1, input [31:0] rs2,
                            input [5*SP_W-1:0] cfg, input [1:0] k,
                            input [3*SP_W-1:0] e1, input [3*SP_W-1:0] e2, input [3*SP_W-1:0] e3);
    reg [SP_W-1:0] atan0, atan1, kc, atanh1, kh;
    reg [SP_W-1:0] e1x, e1y, e1z, e2x, e2y, e2z, e3x, e3y, e3z;
    reg signed [63:0] lo, hi, b, ul, uh, ub, r, m, u, ta, E;
    reg [SP_W+1:0] qa;
    reg [2*SP_W-1:0] sc;
    reg [SP_W-1:0] sn, cs, da, db;
    reg [15:0] q16;
    reg [SP_AW-1:0] t;
    reg zero;
    integer ps, sa, sb, kk, e;
    begin
        ps = 0; sa = 0; sb = 0; kk = 0; e = 0;
        r = 0; m = 0; u = 0; ta = 0; E = 0;
        qa = 0; sc = 0; sn = 0; cs = 0; da = 0; db = 0; q16 = 0; t = 0; zero = 0;
        {kh, atanh1, kc, atan1, atan0} = cfg;
        {e1x, e1y, e1z} = e1;
        {e2x, e2y, e2z} = e2;
        {e3x, e3y, e3z} = e3;
        lo = $signed(rs1[15:0]);            // S3.12 operands
        hi = $signed(rs1[31:16]);
        b  = $signed(rs2[15:0]);
        ul = sp_up(rs1[15:0]);              // the same at engine scale S3.F
        uh = sp_up(rs1[31:16]);
        ub = sp_up(rs2[15:0]);
        sp_alg = {SP_NONE, {(SP_AW-2){1'b0}}};
        case (op)
            // ---------------- base passes (funct7 = 0) ----------------
            // (every finish carries flags = {INV, SAT}; SAT = a 16-bit
            // result, either half of a pair, was clipped by sp_sat)
            5'd0: begin                                     // rot: K*rotate({y,x}, th)
                qa = sp_quad(rs2[15:0]);
                sc = sp_unquad(qa[SP_W+1:SP_W], e1x, e1y);
                {sn, cs} = sc;
                if (k == 0) sp_alg = sp_launch_rot(ul, uh, rs2[15:0]);
                else if (k == 1) sp_alg = sp_finish_f({sp_rnd($signed(sn)), sp_rnd($signed(cs))},
                                                      {1'b0, sp_rnd_s($signed(sn)) || sp_rnd_s($signed(cs))});
            end
            5'd1: begin                                     // sincos
                qa = sp_quad(rs1[15:0]);
                sc = sp_unquad(qa[SP_W+1:SP_W], e1x, e1y);
                {sn, cs} = sc;
                if (k == 0) sp_alg = sp_launch_rot($signed(kc), 0, rs1[15:0]);
                else if (k == 1) sp_alg = sp_finish_f({sp_rnd($signed(sn)), sp_rnd($signed(cs))},
                                                      {1'b0, sp_rnd_s($signed(sn)) || sp_rnd_s($signed(cs))});
            end
            5'd2: begin                                     // vec
                zero = (lo == 0) && (hi == 0);
                if (k == 0) sp_alg = sp_launch_vec(ul, uh);
                else if (k == 1) sp_alg = zero ? sp_finish(32'd0)
                                               : sp_finish_f({sp_rnd($signed(e1z)), sp_rnd($signed(e1x))},
                                                             {1'b0, sp_rnd_s($signed(e1z)) || sp_rnd_s($signed(e1x))});
            end
            5'd3: begin                                     // mac: y + x*z
                if (k == 0) sp_alg = sp_launch(2'd1, 2'd3, ul, uh, ub);
                else if (k == 1) sp_alg = sp_finish_f(sp_sext(sp_rnd($signed(e1y))), {1'b0, sp_rnd_s($signed(e1y))});
            end
            5'd4: begin                                     // ldiv: y / x
                if (k == 0) sp_alg = sp_launch(2'd1, 2'd2, ul, uh, 0);
                else if (k == 1) sp_alg = sp_finish_f(sp_sext(sp_rnd($signed(e1z))), {1'b0, sp_rnd_s($signed(e1z))});
            end
            5'd5: begin                                     // hsincos
                if (k == 0) sp_alg = sp_launch(2'd2, 2'd0, $signed(kh), 0, ul);
                else if (k == 1) sp_alg = sp_finish_f({sp_rnd($signed(e1y)), sp_rnd($signed(e1x))},
                                                      {1'b0, sp_rnd_s($signed(e1y)) || sp_rnd_s($signed(e1x))});
            end
            5'd6: begin                                     // hvec
                zero = (lo == 0) && (hi == 0);
                if (k == 0) sp_alg = sp_launch(2'd2, 2'd1, ul, uh, 0);
                else if (k == 1) sp_alg = zero ? sp_finish(32'd0)
                                               : sp_finish_f({sp_rnd($signed(e1z)), sp_rnd($signed(e1x))},
                                                             {1'b0, sp_rnd_s($signed(e1z)) || sp_rnd_s($signed(e1x))});
            end
            // ---------------- functions (funct7 = 1, 2) ----------------
            5'd8, 5'd9: begin                               // sin, cos
                qa = sp_quad(rs1[15:0]);
                sc = sp_unquad(qa[SP_W+1:SP_W], e1x, e1y);
                {sn, cs} = sc;
                if (k == 0) sp_alg = sp_launch_rot($signed(kc), 0, rs1[15:0]);
                else if (k == 1) sp_alg = sp_finish_f(sp_sext(sp_rnd((op == 5'd8) ? $signed(sn) : $signed(cs))),
                                                      {1'b0, sp_rnd_s((op == 5'd8) ? $signed(sn) : $signed(cs))});
            end
            5'd10: begin                                    // tan = sin / cos
                qa = sp_quad(rs1[15:0]);
                sc = sp_unquad(qa[SP_W+1:SP_W], e1x, e1y);
                {sn, cs} = sc;
                if (k == 0) sp_alg = sp_launch_rot($signed(kc), 0, rs1[15:0]);
                else if (k == 1) sp_alg = sp_fdiv($signed(sn), $signed(cs), 1'b0, 0);
                else if (k == 2) sp_alg = sp_fdiv($signed(sn), $signed(cs), 1'b1, e2z);
            end
            5'd11: begin                                    // atan2(y = rs1, x = rs2)
                ps = sp_norm(sp_max(sp_abs(ul), sp_abs(ub)));
                if (k == 0) sp_alg = (lo == 0 && b == 0) ? sp_finish(32'd0)
                                                        : sp_launch_vec(sp_shl(ub, ps), sp_shl(ul, ps));
                else if (k == 1) sp_alg = sp_finish_f(sp_sext(sp_rnd($signed(e1z))), {1'b0, sp_rnd_s($signed(e1z))});
            end
            5'd12: begin                                    // hypot(x = rs1, y = rs2)
                ps = sp_norm(sp_max(sp_abs(ul), sp_abs(ub)));
                if (k == 0) sp_alg = (lo == 0 && b == 0) ? sp_finish(32'd0)
                                                        : sp_launch_vec(sp_shl(ul, ps), sp_shl(ub, ps));
                else if (k == 1) sp_alg = sp_launch(2'd1, 2'd0, $signed(e1x), 0, SP_INV_K);
                else if (k == 2) sp_alg = sp_finish_f(sp_sext(sp_scale($signed(e2y), -ps)), {1'b0, sp_scale_s($signed(e2y), -ps)});
            end
            5'd13: begin                                    // exp: e^t = 2^k * (cosh r + sinh r)
                kk = sp_expk(lo);
                r  = ul - sp_kln2(kk);
                if (k == 0) sp_alg = sp_launch(2'd2, 2'd0, $signed(kh), 0, r);
                else if (k == 1) sp_alg = sp_finish_f(sp_sext(sp_scale($signed(e1x) + $signed(e1y), kk)),
                                                      {1'b0, sp_scale_s($signed(e1x) + $signed(e1y), kk)});
            end
            5'd14: begin                                    // ln a = 2 atanh((m-1)/(m+1)) + e ln 2
                if (lo > 0) begin
                    e = sp_log2(lo) - 12;
                    m = (e < 0) ? (ul <<< (-e)) : $signed(sp_scale_m(ul, -e));
                end
                if (k == 0) sp_alg = (lo <= 0) ? sp_finish_f(sp_sext(16'h8000), 2'b10)      // INV
                                               : sp_launch(2'd2, 2'd1, m + SP_ONE, m - SP_ONE, 0);
                else if (k == 1) sp_alg = sp_finish_f(sp_sext(sp_rnd(2 * $signed(e1z) + sp_kln2(e))),
                                                      {1'b0, sp_rnd_s(2 * $signed(e1z) + sp_kln2(e))});
            end
            // 15 sqrt, 16 mul, 17 div: no engine pass. They run on the
            // exact unit (src/xc_exact.v): rd = the exact value rounded half up
            // and saturated, flags {INV, SAT}. The SAT solver cannot reason about
            // 16-bit division and multiplication at this size, so the value is
            // established by exhaustive simulation of the unit against integer
            // arithmetic (formal/exhaustive/exact.cpp, every operand); F3 proves
            // the core starts the unit with the instruction's operands and
            // returns its rd (sign-extended) and flags; F6 proves the unit's
            // contract and that its result depends on the operands only.
            //   mul:  floor(a b / 4096 + 1/2)        div:  floor(4096 a / b + 1/2)
            //   sqrt: floor(sqrt(4096 a) + 1/2)      then saturated to [-8, 8) (SAT)
            //   div by 0: INV, rd = 0 (0/0) or 0x7fff / 0x8000 by the sign of a
            //   sqrt of a < 0: INV, rd = 0x8000
            5'd15, 5'd16, 5'd17: sp_alg = {SP_NONE, {(SP_AW-2){1'b0}}};
            5'd18: begin                                    // tanh a = sgn(a) (1 - E) / (1 + E), E = e^(-2|a|)
                if (SP_G == 0) begin                        // -2|a| saturated to S3.12
                    ta = sp_abs(lo);
                    if (ta > 32767) ta = 32767;
                    u  = -2 * ta;
                    if (u < -32768) u = -32768;
                end else                                    // full range [-16, 0]
                    u = -2 * sp_abs(lo);
                kk = sp_expk(u);
                r  = (u <<< SP_G) - sp_kln2(kk);
                E  = $signed(sp_scale_m($signed(e1x) + $signed(e1y), kk));
                da = SP_ONE - E[SP_W-1:0];                  // SP_W-bit, as specified
                db = SP_ONE + E[SP_W-1:0];
                if (k == 0) sp_alg = sp_launch(2'd2, 2'd0, $signed(kh), 0, r);
                else if (k == 1) sp_alg = sp_fdiv($signed(da), $signed(db), 1'b0, 0);
                else if (k == 2) begin
                    t = sp_fdiv($signed(da), $signed(db), 1'b1, e2z);
                    q16 = t[15:0];
                    sp_alg = sp_finish_f(sp_sext((lo < 0) ? 16'd0 - q16 : q16), t[33:32]);
                end
            end
            5'd19: begin                                    // rotc: rotation without gain
                ps = sp_norm(sp_max(sp_abs(ul), sp_abs(uh)));
                qa = sp_quad(rs2[15:0]);
                sc = sp_unquad(qa[SP_W+1:SP_W], e1x, e1y);
                {sn, cs} = sc;
                if (k == 0) sp_alg = (lo == 0 && hi == 0) ? sp_finish(32'd0)
                                     : sp_launch_rot(sp_shl(ul, ps), sp_shl(uh, ps), rs2[15:0]);
                else if (k == 1) sp_alg = sp_launch(2'd1, 2'd0, $signed(cs), 0, SP_INV_K);
                else if (k == 2) sp_alg = sp_launch(2'd1, 2'd0, $signed(sn), 0, SP_INV_K);
                else             sp_alg = sp_finish_f({sp_scale($signed(e3y), -ps), sp_scale($signed(e2y), -ps)},
                                                      {1'b0, sp_scale_s($signed(e3y), -ps) || sp_scale_s($signed(e2y), -ps)});
            end
            default: sp_alg = {SP_NONE, {(SP_AW-2){1'b0}}};
        endcase
    end
endfunction
